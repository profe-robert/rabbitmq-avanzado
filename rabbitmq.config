# Backend de descubrimiento de peers mediante lista clásica
cluster_formation.peer_discovery_backend = rabbit_peer_discovery_classic_config

# Lista de nodos que forman el cluster
cluster_formation.classic_config.nodes.1 = rabbit@rabbitmq-1
cluster_formation.classic_config.nodes.2 = rabbit@rabbitmq-2

# Intervalo (en ms) para limpieza y verificación de estado de nodos
cluster_formation.node_cleanup.interval = 10000

# Ubicación del nodo maestro para las colas
queue_master_location = all